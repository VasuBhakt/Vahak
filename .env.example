PORT=8080
API_KEY=your_secure_api_key_here
ALLOW_LOCAL_TARGETS=false
ALLOW_INSECURE_DEFAULT_KEY=false

# Storage: SQLite by default (zero setup, zero external dependencies)
DB_ENGINE=sqlite
DB_PATH=vahak.db
SQLITE_SYNCHRONOUS=NORMAL # NORMAL (default, process-crash safe) or FULL (physical power loss resilience)
ACK_MODE=durable # durable (default) or fast
RETENTION_DAYS=7

# Optional: External PostgreSQL Cluster
# DB_ENGINE=postgres
# DB_URL=postgres://vahak:vahak_password@localhost:5432/vahak?sslmode=disable
# DB_POOL_URL=postgres://vahak:vahak_password@localhost:5432/vahak?sslmode=disable